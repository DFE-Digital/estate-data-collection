{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "survey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SURV-[A-Za-z0-9-]+$"
        },
        "survey_name": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "surveyor_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "is_complete": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "survey_name",
        "participant_id",
        "is_complete",
        "created_at",
        "updated_at"
      ]
    },
    "school": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "name": {
          "type": "string"
        },
        "local_authority": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "urn",
        "name"
      ]
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "floors": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "type"
              ]
            }
          }
        },
        "required": [
          "name",
          "blocks"
        ]
      }
    }
  },
  "required": [
    "survey",
    "school",
    "sites"
  ],
  "description": "Top-level CCDSurveySubmission-Sites payload container"
}