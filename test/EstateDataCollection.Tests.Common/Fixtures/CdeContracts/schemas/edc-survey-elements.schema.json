{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "survey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SURV-[A-Za-z0-9-]+$"
        },
        "survey_name": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "surveyor_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "is_complete": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "survey_name",
        "participant_id",
        "is_complete",
        "created_at",
        "updated_at"
      ]
    },
    "school": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "urn"
      ]
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ELM-[0-9]+$"
          },
          "NRM3_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "site",
              "block",
              "floor",
              "space"
            ]
          },
          "occurrences": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^OCC-[0-9]+$"
                },
                "name": {
                  "type": "string"
                },
                "basis_of_assessment": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "Seen",
                    "Not Seen",
                    "Assumed",
                    null
                  ]
                },
                "condition_grade": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    null
                  ]
                },
                "condition_description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "replacement": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "rem_life": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "uom": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "replacement_quantity": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "replacement_rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": []
                },
                "repairs": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^REP-[0-9]+$"
                      },
                      "repair_description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "repair_item": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "repair_classification": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "X",
                          "Y",
                          "Z",
                          null
                        ]
                      },
                      "uom": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "repair_quantity": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "repair_rate": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "estimated_cost": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "NRM3_code",
          "description",
          "asset_id",
          "asset_type"
        ]
      }
    }
  },
  "required": [
    "survey",
    "school",
    "elements"
  ],
  "description": "Top-level CCDSurveySubmission payload container"
}