{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "survey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SURV-[A-Za-z0-9-]+$"
        },
        "survey_name": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "surveyor_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "is_complete": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "survey_name",
        "participant_id",
        "is_complete",
        "created_at",
        "updated_at"
      ]
    },
    "school": {
      "type": "object",
      "properties": {
        "urn": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "urn"
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ANS-[0-9]+$"
          },
          "question_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "site",
              "block",
              "floor",
              "space",
              "element"
            ]
          },
          "value": {
            "type": "string",
            "description": "Survey response value. Actual datatype is determined by value_type."
          },
          "value_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "text",
              "number",
              "boolean",
              "lookup_list",
              "date",
              null
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]+$"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        "required": [
          "id",
          "question_id",
          "asset_id",
          "asset_type",
          "value"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVD-[0-9]+$"
          },
          "file_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "mime_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "survey",
    "school",
    "answers",
    "evidence"
  ],
  "description": "Top-level CCDSurveySubmission payload container"
}