@adminBaseUrl = http://localhost:7072/api
@adminFunctionKey = 
@schemaName = edc_payload
@odcsSiteSchemaName = edc-survey-sites

### =========================================================================
### 1. ADMIN SCHEMA & QUALITY RULE VERIFICATION — DRY-RUN
### =========================================================================

### 1.1 Verify Schema Candidate (Draft 2020-12 / Draft-07 Syntax & Fixture Dry-Run)
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"title\": \"edc_payload\", \"schemaVersion\": 1, \"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"integer\"}, \"school_name\": {\"type\": \"string\"}, \"school_address\": {\"type\": \"string\"}, \"school_capacity\": {\"type\": [\"integer\", \"null\"]}}, \"required\": [\"urn\", \"school_name\", \"school_address\"], \"additionalProperties\": false}",
  "sampleValidFixtures": [
    "{\"urn\": 104521, \"school_name\": \"St Mary's High School\", \"school_address\": \"High Street, Leeds\", \"school_capacity\": 450}"
  ],
  "sampleInvalidFixtures": [
    "{\"school_name\": \"Missing URN and Address\"}"
  ]
}


### 1.2 Verify Multi-Engine Quality Rules (JsonLogic & CEL) via /schemas/verify
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "rulesJson": "[{\"id\": \"CDC-DQ1-JSONLogic\", \"type\": \"custom\", \"engine\": \"jsonlogic\", \"description\": \"Survey updated timestamp must be >= created timestamp.\", \"severity\": \"ERROR\", \"path\": \"survey\", \"message\": \"Survey updated timestamp must be greater than or equal to survey creation timestamp.\", \"implementation\": {\">=\": [{\"var\": \"survey.updated_at\"}, {\"var\": \"survey.created_at\"}]}}, {\"id\": \"CDC-DQ2-CEL-CAPACITY\", \"type\": \"custom\", \"engine\": \"cel\", \"description\": \"School capacity when present must be positive.\", \"severity\": \"ERROR\", \"path\": \"school\", \"message\": \"School capacity must be greater than zero.\", \"implementation\": \"school.capacity > 0\"}]",
  "sampleValidFixtures": [
    "{\"survey\": {\"id\": \"SURV-001\", \"created_at\": \"2026-10-15T10:00:00Z\", \"updated_at\": \"2026-10-15T14:30:00Z\"}, \"school\": {\"urn\": \"123456\", \"capacity\": 450}}"
  ],
  "sampleInvalidFixtures": [
    "{\"survey\": {\"id\": \"SURV-001\", \"created_at\": \"2026-10-15T16:00:00Z\", \"updated_at\": \"2026-10-15T10:00:00Z\"}, \"school\": {\"urn\": \"123456\", \"capacity\": 450}}"
  ]
}


### 1.3 Verify ODCS v3.2.0 Data Contract (Direct Raw YAML)
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/yaml
X-File-Name: edc-school-site-jsonlogic.odcs.yaml
x-functions-key: {{adminFunctionKey}}

< ../../cde-data-contracts/contracts/edc-school-site-jsonlogic.odcs.yaml


### =========================================================================
### 2. ADMIN SCHEMA SUBMISSION, SCHEDULING & CATALOGUE MANAGEMENT
### =========================================================================

### 2.1 Submit Schema v1 with URN Identifier Metadata (Stored as 'Validated' / Unscheduled)
POST {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"title\": \"edc_payload\", \"schemaVersion\": 1, \"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"integer\", \"minimum\": 100000, \"maximum\": 999999}, \"school_name\": {\"type\": \"string\"}, \"school_address\": {\"type\": \"string\"}, \"school_capacity\": {\"type\": [\"integer\", \"null\"]}}, \"required\": [\"urn\", \"school_name\", \"school_address\"], \"additionalProperties\": false}",
  "rulesJson": "[{\"id\": \"RULE-CAPACITY-POSITIVE\", \"type\": \"custom\", \"engine\": \"jsonlogic\", \"description\": \"School capacity must be positive\", \"severity\": \"ERROR\", \"path\": \"school_capacity\", \"message\": \"School capacity must be greater than zero when specified.\", \"implementation\": {\"or\": [{\"==\": [{\"var\": \"school_capacity\"}, null]}, {\">\": [{\"var\": \"school_capacity\"}, 0]}]}}]",
  "identifierConfig": {
    "type": "URN",
    "jsonPointer": "/urn",
    "required": true
  }
}


### 2.2 Submit ODCS v3.2.0 Contract via File Streaming (edc-survey-sites v1)
POST {{adminBaseUrl}}/schemas/{{odcsSiteSchemaName}}/versions/1
Content-Type: application/yaml
X-File-Name: edc-school-site-jsonlogic.odcs.yaml
X-Urn-Pointer: /school/urn
X-Urn-Required: true
x-functions-key: {{adminFunctionKey}}

< ../../cde-data-contracts/contracts/edc-school-site-jsonlogic.odcs.yaml


### 2.3 Get Admin Schema Catalogue (Includes Unscheduled, Upcoming & Retired Versions by Default)
GET {{adminBaseUrl}}/schemas?includeUnscheduled=true&includeUpcoming=true&includeRetired=true&includeFields=true
Accept: application/json
x-functions-key: {{adminFunctionKey}}


### 2.4 Get Admin Schema Version Detail (Includes Raw JSON Schema, Extracted Fields, Quality Rules & IdentifierConfig)
GET {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1?includeUnscheduled=true&includeUpcoming=true&includeRetired=true&includeRawJsonSchema=true
Accept: application/json
x-functions-key: {{adminFunctionKey}}


### 2.5 Schedule / Activate Schema Version & Configure URN Pointer Metadata
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "effectiveFromUtc": "2026-01-01T00:00:00Z",
  "effectiveToUtc": "2027-12-31T23:59:59Z",
  "lifecycleAction": "Schedule",
  "identifierConfig": {
    "type": "URN",
    "jsonPointer": "/urn",
    "required": true
  }
}


### 2.6 Schedule / Activate ODCS Site Schema & Configure Nested URN Pointer (/school/urn)
PATCH {{adminBaseUrl}}/schemas/{{odcsSiteSchemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "effectiveFromUtc": "2026-01-01T00:00:00Z",
  "effectiveToUtc": "2027-12-31T23:59:59Z",
  "lifecycleAction": "Schedule",
  "identifierConfig": {
    "type": "URN",
    "jsonPointer": "/school/urn",
    "required": true
  }
}


### 2.7 Update IdentifierConfig Metadata Only (Without Changing Lifecycle State)
PATCH {{adminBaseUrl}}/schemas/edc-survey-elements/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "identifierConfig": {
    "type": "None",
    "jsonPointer": null,
    "required": false
  }
}


### 2.8 Deprecate Schema Version
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "lifecycleAction": "Deprecate"
}


### 2.9 Retire Schema Version
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "lifecycleAction": "Retire"
}
