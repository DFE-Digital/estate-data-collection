@using EstateDataCollection.Admin.UI.Models.ViewModels
@namespace EstateDataCollection.Admin.UI.Pages

<DfeAdminLayout Model="Model.Page">
    <NotificationBanner Model="Model.SuccessBannerModel" />
    <NotificationBanner Model="Model.ValidatedUnscheduledBannerModel" />
    <NotificationBanner Model="Model.ErrorReportAttentionBannerModel" />
    <ErrorSummary Model="Model.ErrorSummary" />

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-3">Schema Contracts &amp; Lifecycle</h1>
            <p class="govuk-body-l">
                Inspect registered JSON Schema and ODCS v3 data contracts, verify quality rules (JsonLogic &amp; CEL), and manage activation windows.
            </p>
        </div>
        <div class="govuk-grid-column-one-third" style="text-align: right;">
            <div class="dfe-actions-inline" style="justify-content: flex-end;">
                <form method="post" action="@AppRoutes.AdminUi.RunAllTests" style="display: inline-block; margin: 0;">
                    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        Run All Schema Tests
                    </button>
                </form>
                <a href="@AppRoutes.AdminUi.Workbench" class="govuk-button" data-module="govuk-button">
                    Upload or Verify Contract
                </a>
            </div>
        </div>
    </div>

    @if (Model.TestRunSummary is not null)
    {
        <div class="govuk-summary-card govuk-!-margin-bottom-6" id="schema-test-run-summary">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">
                    Schema Suite Test Run &mdash; Build <code class="dfe-code-badge">@Model.TestRunSummary.AppVersion</code>
                </h2>
                <ul class="govuk-summary-card__actions">
                    <li class="govuk-summary-card__action">
                        <strong class="@Model.TestRunSummary.SummaryTagCssClass">@Model.TestRunSummary.SummaryTagText</strong>
                    </li>
                </ul>
            </div>
            <div class="govuk-summary-card__content">
                @if (Model.TestRunSummary.NoResults)
                {
                    <p class="govuk-body govuk-!-margin-bottom-0">No non-retired schemas found to test.</p>
                }
                else
                {
                    <table class="govuk-table govuk-!-margin-bottom-0">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Schema</th>
                                <th scope="col" class="govuk-table__header">State</th>
                                <th scope="col" class="govuk-table__header">Fixtures / Rules</th>
                                <th scope="col" class="govuk-table__header">Engines</th>
                                <th scope="col" class="govuk-table__header">Result</th>
                                <th scope="col" class="govuk-table__header">Details</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var item in Model.TestRunSummary.Results)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">
                                        <a href="@item.TestsUrl" class="govuk-link">
                                            @item.SchemaDisplayName
                                        </a>
                                    </td>
                                    <td class="govuk-table__cell"><LifecycleTag Model="item.StateTag" /></td>
                                    <td class="govuk-table__cell govuk-body-s">
                                        @item.CountsSummary
                                    </td>
                                    <td class="govuk-table__cell govuk-body-s">
                                        @if (item.HasEngineTracesSummary)
                                        {
                                            <code class="dfe-code-badge">@item.EngineTracesSummary</code>
                                        }
                                        else
                                        {
                                            <span class="govuk-hint">&mdash;</span>
                                        }
                                    </td>
                                    <td class="govuk-table__cell">
                                        <strong class="@item.ResultTagCssClass">@item.ResultTagText</strong>
                                    </td>
                                    <td class="govuk-table__cell govuk-body-s">
                                        @if (item.HasDetailsText)
                                        {
                                            @item.DetailsText
                                        }
                                        else
                                        {
                                            <span class="govuk-hint">OK</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    <div class="dfe-stats-grid" aria-label="Registry summary">
        <div class="dfe-stat-card">
            <span class="dfe-stat-card__value">@Model.TotalSchemas</span>
            <span class="dfe-stat-card__label">Schema families</span>
        </div>
        <div class="dfe-stat-card dfe-stat-card--accent">
            <span class="dfe-stat-card__value">@Model.TotalVersions</span>
            <span class="dfe-stat-card__label">Total versions</span>
        </div>
        <div class="dfe-stat-card dfe-stat-card--success">
            <span class="dfe-stat-card__value">@Model.ActiveVersions</span>
            <span class="dfe-stat-card__label">Active boundaries</span>
        </div>
        <div class="dfe-stat-card dfe-stat-card--attention">
            <span class="dfe-stat-card__value">@Model.ValidatedUnscheduledCount</span>
            <span class="dfe-stat-card__label">Validated (unscheduled)</span>
        </div>
    </div>

    @if (Model.NoSchemas)
    {
        <div class="govuk-inset-text">
            No schemas are currently registered in blob storage. Use the <a href="@AppRoutes.AdminUi.Workbench" class="govuk-link">Contract Workbench</a> or drop an <code class="dfe-code-badge">.odcs.yaml</code> contract into <code class="dfe-code-badge">draft-schemas</code>.
        </div>
    }
    else
    {
        @foreach (var card in Model.SchemaCards)
        {
            <SchemaSectionCard Model="card" />
        }
    }
</DfeAdminLayout>

@code {
    [Parameter, EditorRequired] public DashboardViewModel Model { get; set; } = default!;
}
