@using EstateDataCollection.Admin.UI.Models.ViewModels
@namespace EstateDataCollection.Admin.UI.Components

@if (Model is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>

        <div class="govuk-error-summary__body">
            <p class="govuk-body">
                <strong>@Model.Code</strong>: @Model.Description
            </p>
            @if (Model.HasValidationErrors)
            {
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var ve in Model.ValidationErrors)
                    {
                        <li>
                            @if (ve.HasPropertyPath)
                            {
                                <span><strong>@ve.PropertyPath:</strong> @ve.Message</span>
                            }
                            else
                            {
                                <span>@ve.Message</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ErrorSummaryViewModel? Model { get; set; }
}
