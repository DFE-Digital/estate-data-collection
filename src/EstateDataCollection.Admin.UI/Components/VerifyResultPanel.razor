@using EstateDataCollection.Admin.UI.Models.ViewModels
@namespace EstateDataCollection.Admin.UI.Components

@if (Model is not null)
{
    if (Model.ShowPanel)
    {
        if (Model.HasError)
        {
            <ErrorSummary Model="Model.ErrorSummary" />
        }

        if (Model.HasResult)
        {
            <NotificationBanner Model="Model.SuccessBanner" />
        }

        if (Model.HasReport)
        {
            if (Model.HasWarnings)
            {
                <div class="govuk-warning-text govuk-!-margin-bottom-3">
                    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                    <strong class="govuk-warning-text__text">
                        <span class="govuk-visually-hidden">Warning</span>
                        @if (Model.AllWarningsAreUnknownInvalidFixtures)
                        {
                            <span>@Model.WarningCount invalid fixture(s) failed validation, but it is unknown if expected because <code class="dfe-code-badge">expectedErrors</code> was not configured.</span>
                        }
                        else
                        {
                            <span>@Model.WarningCount warning(s) recorded during contract verification:</span>
                        }
                    </strong>
                </div>
                if (Model.ShowWarningBullets)
                {
                    <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-4">
                        @foreach (var warn in Model.Warnings)
                        {
                            <li>@warn</li>
                        }
                    </ul>
                }
            }

            if (Model.ShowTabs)
            {
                <div class="govuk-tabs govuk-!-margin-bottom-6" data-module="govuk-tabs" id="@Model.Tabs.ContainerId" data-default-tab="@Model.Tabs.DefaultTabId">
                    <GovUkTabStrip Model="Model.Tabs" />

                    <GovUkTabPanel Tab="Model.SummaryTab">
                        @if (Model.HasIssueGroups)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3" id="verify-issues-by-severity">
                                <strong>Issues by severity:</strong>
                                @foreach (var group in Model.IssueGroups)
                                {
                                    <div class="govuk-!-margin-top-2">
                                        <strong class="@group.TagCssClass">@group.SeverityLabel (@group.Count)</strong>
                                        <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                            @foreach (var item in group.Items)
                                            {
                                                <li>
                                                    @if (item.HasPropertyPath)
                                                    {
                                                        <code class="dfe-code-badge">@item.PropertyPath</code>
                                                    }
                                                    <span>@item.Message</span>
                                                    @if (item.HasEngineId)
                                                    {
                                                        <span class="govuk-hint">(@item.EngineId)</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }

                        @if (Model.HasAnalyzerFindings)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3" id="verify-analyzer-findings">
                                <strong>Contract consistency analyzer findings (@Model.AnalyzerFindings.Count):</strong>
                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                    @foreach (var finding in Model.AnalyzerFindings)
                                    {
                                        <li>
                                            <strong class="@finding.SeverityTagCssClass">@finding.SeverityName</strong>
                                            @if (finding.HasPropertyPath)
                                            {
                                                <code class="dfe-code-badge">@finding.PropertyPath</code>
                                            }
                                            <span>@finding.Message</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.HasSyntaxErrors)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3">
                                <strong>Syntax errors (@Model.SyntaxErrors.Count):</strong>
                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                    @foreach (var err in Model.SyntaxErrors)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.HasFixtureErrors)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3">
                                <strong>Fixture errors (@Model.FixtureErrors.Count):</strong>
                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                    @foreach (var err in Model.FixtureErrors)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.HasInvalidFixtureOutcomes)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3">
                                <strong>Invalid fixture triggered errors:</strong>
                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                    @foreach (var outcome in Model.InvalidFixtureOutcomes)
                                    {
                                        <li>
                                            <strong>@outcome.Title</strong>
                                            @if (outcome.HasDescription)
                                            {
                                                <span>(@outcome.Description)</span>
                                            }
                                            &mdash;
                                            <strong class="@outcome.StatusTagCssClass">@outcome.StatusTagText</strong>
                                            <div class="govuk-!-margin-top-1">
                                                @foreach (var err in outcome.TriggeredErrors)
                                                {
                                                    <div><code class="dfe-code-badge">@err.FormatDisplay()</code></div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.HasResolvedIdentifierConfig)
                        {
                            <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-0">
                                @if (Model.IsIdentifierDisabled)
                                {
                                    <span><strong>Identifier extraction:</strong> Disabled (<code class="dfe-code-badge">None</code>)</span>
                                }
                                else
                                {
                                    <span>
                                        <strong>Verified identifier:</strong> <code class="dfe-code-badge">@Model.IdentifierType</code>
                                        at <code class="dfe-code-badge">@Model.IdentifierPointerDisplay</code>
                                        &bull; Required by schema: <strong>@Model.IdentifierRequiredDisplay</strong>
                                    </span>
                                }
                            </div>
                        }

                        @if (Model.NoSummaryDetails)
                        {
                            <p class="govuk-body govuk-!-margin-bottom-0">
                                Contract syntax and quality rules verified cleanly with no invalid fixture outcomes.
                            </p>
                        }
                    </GovUkTabPanel>

                    <GovUkTabPanel Tab="Model.EngineDiagnosticsTab">
                        <ValidationEngineDiagnostics Model="Model.EngineDiagnostics" />
                    </GovUkTabPanel>
                </div>
            }
            else
            {
                if (Model.HasIssueGroups)
                {
                    <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3" id="verify-issues-by-severity">
                        <strong>Issues by severity:</strong>
                        @foreach (var group in Model.IssueGroups)
                        {
                            <div class="govuk-!-margin-top-2">
                                <strong class="@group.TagCssClass">@group.SeverityLabel (@group.Count)</strong>
                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                                    @foreach (var item in group.Items)
                                    {
                                        <li>
                                            @if (item.HasPropertyPath)
                                            {
                                                <code class="dfe-code-badge">@item.PropertyPath</code>
                                            }
                                            <span>@item.Message</span>
                                            @if (item.HasEngineId)
                                            {
                                                <span class="govuk-hint">(@item.EngineId)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }

                if (Model.HasInvalidFixtureOutcomes)
                {
                    <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0 govuk-!-margin-bottom-3">
                        <strong>Invalid fixture triggered errors:</strong>
                        <ul class="govuk-list govuk-list--bullet govuk-!-margin-top-1 govuk-!-margin-bottom-0">
                            @foreach (var outcome in Model.InvalidFixtureOutcomes)
                            {
                                <li>
                                    <strong>@outcome.Title</strong>
                                    @if (outcome.HasDescription)
                                    {
                                        <span>(@outcome.Description)</span>
                                    }
                                    &mdash;
                                    <strong class="@outcome.StatusTagCssClass">@outcome.StatusTagText</strong>
                                    <div class="govuk-!-margin-top-1">
                                        @foreach (var err in outcome.TriggeredErrors)
                                        {
                                            <div><code class="dfe-code-badge">@err.FormatDisplay()</code></div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

                if (Model.HasResolvedIdentifierConfig)
                {
                    <div class="govuk-inset-text govuk-body-s govuk-!-margin-top-0">
                        @if (Model.IsIdentifierDisabled)
                        {
                            <span><strong>Identifier extraction:</strong> Disabled (<code class="dfe-code-badge">None</code>)</span>
                        }
                        else
                        {
                            <span>
                                <strong>Verified identifier:</strong> <code class="dfe-code-badge">@Model.IdentifierType</code>
                                at <code class="dfe-code-badge">@Model.IdentifierPointerDisplay</code>
                                &bull; Required by schema: <strong>@Model.IdentifierRequiredDisplay</strong>
                            </span>
                        }
                    </div>
                }
            }
        }
    }
}

@code {
    [Parameter] public WorkbenchVerifyViewModel? Model { get; set; }
}
