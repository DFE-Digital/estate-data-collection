<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AzureFunctionsVersion>v4</AzureFunctionsVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AzureExtensions.Swashbuckle" />
        <PackageReference Include="Scalar.Azure.Functions" />
        <PackageReference Include="Scrutor" />
        <PackageReference Include="Microsoft.Azure.Functions.Worker" />
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\docs\openapi\overview.md"
                          LogicalName="EstateDataCollection.AzureFunctions.Public.OpenApi.overview.md" />
    </ItemGroup>

    <ItemGroup>
        <None Update="host.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="local.settings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EstateDataCollection.Application\EstateDataCollection.Application.csproj" />
        <ProjectReference Include="..\EstateDataCollection.Common.Web\EstateDataCollection.Common.Web.csproj" />
        <ProjectReference Include="..\EstateDataCollection.Common\EstateDataCollection.Common.csproj" />
        <ProjectReference Include="..\EstateDataCollection.Domain\EstateDataCollection.Domain.csproj" />
        <ProjectReference Include="..\EstateDataCollection.Infrastructure\EstateDataCollection.Infrastructure.csproj" />
    </ItemGroup>
    
</Project>
