### 6.1 Submit CDC Survey Schema v1 with 10 Companion Quality Rules (Admin API)
# Registers the full CCDSurveySubmission JSON Schema alongside its 10 JsonLogic business rules.
POST {{adminBaseUrl}}/schemas/{{cdcSchemaName}}/versions/1
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"title\": \"CCDSurveySubmission\", \"type\": \"object\", \"additionalProperties\": false, \"required\": [\"survey\", \"school\", \"sites\", \"elements\", \"answers\", \"evidence\"], \"properties\": {\"survey\": {\"type\": \"object\", \"required\": [\"id\", \"survey_name\", \"participant_id\", \"is_complete\", \"created_at\", \"updated_at\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^SURV-[A-Za-z0-9-]+$\"}, \"survey_name\": {\"type\": \"string\"}, \"participant_id\": {\"type\": \"string\"}, \"surveyor_email\": {\"type\": \"string\", \"format\": \"email\"}, \"is_complete\": {\"type\": \"boolean\"}, \"created_at\": {\"type\": \"string\", \"format\": \"date-time\"}, \"updated_at\": {\"type\": \"string\", \"format\": \"date-time\"}}, \"additionalProperties\": false}, \"school\": {\"type\": \"object\", \"required\": [\"urn\"], \"properties\": {\"urn\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}, \"additionalProperties\": false}, \"sites\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/site\"}}, \"elements\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/element\"}}, \"answers\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/answer\"}}, \"evidence\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/evidence\"}}}, \"$defs\": {\"site\": {\"type\": \"object\", \"required\": [\"name\", \"blocks\"], \"properties\": {\"name\": {\"type\": \"string\"}, \"blocks\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/block\"}}}, \"additionalProperties\": false}, \"block\": {\"type\": \"object\", \"required\": [\"name\", \"type\"], \"properties\": {\"name\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\", \"enum\": [\"block\"]}, \"floors\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/floor\"}}}, \"additionalProperties\": false}, \"floor\": {\"type\": \"object\", \"required\": [\"name\"], \"properties\": {\"name\": {\"type\": \"string\"}}, \"additionalProperties\": false}, \"element\": {\"type\": \"object\", \"required\": [\"id\", \"NRM3_code\", \"description\", \"asset_id\", \"asset_type\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^ELM-[0-9]+$\"}, \"NRM3_code\": {\"type\": \"string\"}, \"description\": {\"type\": \"string\"}, \"asset_id\": {\"type\": \"string\"}, \"asset_type\": {\"type\": \"string\", \"enum\": [\"site\", \"block\", \"floor\", \"space\"]}, \"occurrences\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/occurrence\"}}}, \"additionalProperties\": false}, \"occurrence\": {\"type\": \"object\", \"required\": [\"id\", \"name\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^OCC-[0-9]+$\"}, \"name\": {\"type\": \"string\"}, \"basis_of_assessment\": {\"type\": \"string\", \"enum\": [\"Seen\", \"Not Seen\", \"Assumed\"]}, \"condition_grade\": {\"type\": \"string\", \"enum\": [\"A\", \"B\", \"C\", \"D\"]}, \"condition_description\": {\"type\": \"string\"}, \"replacement\": {\"$ref\": \"#/$defs/replacement\"}, \"repairs\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/repair\"}}}, \"additionalProperties\": false}, \"replacement\": {\"type\": \"object\", \"properties\": {\"rem_life\": {\"type\": \"integer\", \"minimum\": 0}, \"uom\": {\"type\": \"string\"}, \"replacement_quantity\": {\"type\": \"number\", \"minimum\": 0}, \"replacement_rate\": {\"type\": \"number\", \"minimum\": 0}}, \"additionalProperties\": false}, \"repair\": {\"type\": \"object\", \"required\": [\"id\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^REP-[0-9]+$\"}, \"repair_description\": {\"type\": \"string\"}, \"repair_item\": {\"type\": \"string\"}, \"repair_classification\": {\"type\": \"string\", \"enum\": [\"X\", \"Y\", \"Z\"]}, \"uom\": {\"type\": \"string\"}, \"repair_quantity\": {\"type\": \"number\", \"minimum\": 0}, \"repair_rate\": {\"type\": \"number\", \"minimum\": 0}, \"estimated_cost\": {\"type\": \"number\", \"minimum\": 0}}, \"additionalProperties\": false}, \"answer\": {\"type\": \"object\", \"required\": [\"id\", \"question_id\", \"asset_id\", \"asset_type\", \"value\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^ANS-[0-9]+$\"}, \"question_id\": {\"type\": \"string\"}, \"asset_id\": {\"type\": \"string\"}, \"asset_type\": {\"type\": \"string\", \"enum\": [\"site\", \"block\", \"floor\", \"space\", \"element\"]}, \"value\": {}, \"value_type\": {\"type\": \"string\", \"enum\": [\"text\", \"number\", \"boolean\", \"lookup_list\", \"date\"]}, \"created_at\": {\"type\": \"string\", \"format\": \"date-time\"}, \"updated_at\": {\"type\": \"string\", \"format\": \"date-time\"}, \"evidence\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"id\"], \"properties\": {}}}}}, \"evidence\": {\"type\": \"object\", \"required\": [\"id\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^EVD-[0-9]+$\"}, \"asset_id\": {\"type\": \"string\"}, \"asset_type\": {\"type\": \"string\"}, \"description\": {\"type\": \"string\"}, \"mime_type\": {\"type\": \"string\"}, \"blob_key\": {\"type\": \"string\"}, \"file_origin\": {\"type\": \"string\"}, \"created_at\": {\"type\": \"string\", \"format\": \"date-time\"}, \"updated_at\": {\"type\": \"string\", \"format\": \"date-time\"}}, \"additionalProperties\": false}}}",
  "rulesJson": "[{\"id\": \"RULE-CONDITION-GRADE-D\", \"description\": \"Condition Grade D elements must have at least one repair identified.\", \"severity\": \"ERROR\", \"path\": \"elements[].occurrences[].repairs\", \"message\": \"At least one repair must be provided when condition grade is D.\", \"assert\": {\"or\": [{\"!=\": [{\"var\": \"condition_grade\"}, \"D\"]}, {\">\": [{\"var\": \"repairs.length\"}, 0]}]}}, {\"id\": \"RULE-REPLACEMENT-LIFE\", \"description\": \"Grade D elements should have a replacement life specified.\", \"severity\": \"ERROR\", \"path\": \"elements[].occurrences[].replacement.rem_life\", \"message\": \"Replacement remaining life is required when condition grade is D.\", \"assert\": {\"or\": [{\"!=\": [{\"var\": \"condition_grade\"}, \"D\"]}, {\"!=\": [{\"var\": \"replacement.rem_life\"}, null]}]}}, {\"id\": \"RULE-REPAIR-COST-CALCULATION\", \"description\": \"Repair cost must equal quantity multiplied by rate.\", \"severity\": \"ERROR\", \"path\": \"elements[].occurrences[].repairs[].estimated_cost\", \"message\": \"Estimated cost must equal repair quantity \\u00d7 repair rate.\", \"assert\": {\"==\": [{\"var\": \"estimated_cost\"}, {\"*\": [{\"var\": \"repair_quantity\"}, {\"var\": \"repair_rate\"}]}]}}, {\"id\": \"RULE-REPLACEMENT-COST-REQUIRED\", \"description\": \"Assets nearing end of life must have a replacement quantity and rate.\", \"severity\": \"ERROR\", \"path\": \"elements[].occurrences[].replacement\", \"message\": \"Replacement quantity and rate are required when remaining life is less than or equal to 5 years.\", \"assert\": {\"or\": [{\">\": [{\"var\": \"replacement.rem_life\"}, 5]}, {\"and\": [{\">\": [{\"var\": \"replacement.replacement_quantity\"}, 0]}, {\">\": [{\"var\": \"replacement.replacement_rate\"}, 0]}]}]}}, {\"id\": \"RULE-EVIDENCE-REQUIRED\", \"description\": \"Poor or critical conditions must have supporting evidence.\", \"severity\": \"ERROR\", \"path\": \"answers[].evidence\", \"message\": \"Evidence is required for condition grades C and D.\", \"assert\": {\"or\": [{\"!in\": [{\"var\": \"condition_grade\"}, [\"C\", \"D\"]]}, {\">\": [{\"var\": \"evidence.length\"}, 0]}]}}, {\"id\": \"RULE-SITE-ANSWER-VALIDATION\", \"description\": \"Site level answers must reference a valid site asset.\", \"severity\": \"ERROR\", \"path\": \"answers[].asset_id\", \"message\": \"Site answers must reference an existing site.\", \"assert\": {\"or\": [{\"!=\": [{\"var\": \"asset_type\"}, \"site\"]}, {\"in\": [{\"var\": \"asset_id\"}, {\"var\": \"valid_site_ids\"}]}]}}, {\"id\": \"RULE-BLOCK-ANSWER-VALIDATION\", \"description\": \"Block level answers must reference a valid block.\", \"severity\": \"ERROR\", \"path\": \"answers[].asset_id\", \"message\": \"Block answers must reference an existing block.\", \"assert\": {\"or\": [{\"!=\": [{\"var\": \"asset_type\"}, \"block\"]}, {\"in\": [{\"var\": \"asset_id\"}, {\"var\": \"valid_block_ids\"}]}]}}, {\"id\": \"RULE-EVIDENCE-REFERENCE\", \"description\": \"Evidence references must exist in the submission evidence collection.\", \"severity\": \"ERROR\", \"path\": \"answers[].evidence[].id\", \"message\": \"Evidence reference does not exist.\", \"assert\": {\"in\": [{\"var\": \"id\"}, {\"var\": \"valid_evidence_ids\"}]}}, {\"id\": \"RULE-ANSWER-VALUE-TYPE\", \"description\": \"Answer value must match declared value type.\", \"severity\": \"ERROR\", \"path\": \"answers[].value\", \"message\": \"Answer value does not match configured value type.\", \"assert\": {\"or\": [{\"and\": [{\"==\": [{\"var\": \"value_type\"}, \"number\"]}, {\"==\": [{\"var\": \"value_is_numeric\"}, true]}]}, {\"and\": [{\"==\": [{\"var\": \"value_type\"}, \"boolean\"]}, {\"==\": [{\"var\": \"value_is_boolean\"}, true]}]}, {\"==\": [{\"var\": \"value_type\"}, \"text\"]}, {\"==\": [{\"var\": \"value_type\"}, \"lookup_list\"]}]}}, {\"id\": \"RULE-QUESTION-ASSET-TYPE\", \"description\": \"Question must be answered against the correct hierarchy level.\", \"severity\": \"ERROR\", \"path\": \"answers[].asset_type\", \"message\": \"Question cannot be answered at this asset level.\", \"assert\": {\"==\": [{\"var\": \"asset_type\"}, {\"var\": \"question.expected_asset_type\"}]}}]"
}


