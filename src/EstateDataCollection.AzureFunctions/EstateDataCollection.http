### =========================================================================
### 0. OBSERVABILITY & DIAGNOSTICS (Public API)
### =========================================================================

### 0.1 Service About & Version Metadata
# Anonymous health/diagnostic endpoint returning service name, CalVer version, commit SHA, and environment.
GET {{baseUrl}}/about
Accept: application/json


### =========================================================================
### 1. ADMIN SCHEMA & QUALITY RULE VERIFICATION — DRY-RUN (Admin API)
###    Supports JSON Schema (Draft-07 & 2020-12), ODCS v3.2.0 YAML,
###    and Multi-Engine Quality Rules (JsonLogic & CEL)
### =========================================================================

### 1.1 Verify Schema Candidate (Draft 2020-12 Syntax & Fixture Dry-Run)
# Route: POST /schemas/verify
# Does NOT write to Blob Storage. Validates schema and tests against sample payloads.
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"title\": \"edc_payload\", \"schemaVersion\": 1, \"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"integer\"}, \"school_name\": {\"type\": \"string\"}, \"school_address\": {\"type\": \"string\"}, \"school_capacity\": {\"type\": [\"integer\", \"null\"]}}, \"required\": [\"urn\", \"school_name\", \"school_address\"], \"additionalProperties\": false}",
  "sampleValidFixtures": [
    "{\"urn\": 104521, \"school_name\": \"St Mary's High School\", \"school_address\": \"High Street, Leeds\", \"school_capacity\": 450}"
  ],
  "sampleInvalidFixtures": [
    "{\"school_name\": \"Missing URN and Address\"}"
  ]
}


### 1.2 Verify Standalone Quality Rules (Direct Raw Array — JsonLogic & CEL)
# Route: POST /logic/verify accepts a direct JSON array of quality rules across enabled engines
POST {{adminBaseUrl}}/logic/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

[
  {
    "id": "CDC-DQ1-JSONLogic",
    "type": "custom",
    "engine": "jsonlogic",
    "description": "Survey updated timestamp must be greater than or equal to survey creation timestamp.",
    "severity": "ERROR",
    "path": "survey",
    "message": "Survey updated timestamp must be greater than or equal to survey creation timestamp.",
    "implementation": {
      ">=": [
        { "var": "survey.updated_at" },
        { "var": "survey.created_at" }
      ]
    }
  },
  {
    "id": "CDC-DQ2-CEL",
    "type": "custom",
    "engine": "cel",
    "description": "School URN must be a 6-character string and survey must have a non-empty participant_id.",
    "severity": "ERROR",
    "path": "school",
    "message": "School URN must be 6 characters long.",
    "implementation": "size(school.urn) == 6"
  }
]


### 1.3 Verify Multi-Engine Quality Rules (JsonLogic + CEL) with Fixture Dry-Runs
# Route: POST /logic/verify with rulesJson, sampleValidFixtures, and sampleInvalidFixtures
POST {{adminBaseUrl}}/logic/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "rulesJson": "[{\"id\": \"CDC-DQ1-JSONLogic\", \"type\": \"custom\", \"engine\": \"jsonlogic\", \"description\": \"Survey updated timestamp must be >= created timestamp.\", \"severity\": \"ERROR\", \"path\": \"survey\", \"message\": \"Survey updated timestamp must be greater than or equal to survey creation timestamp.\", \"implementation\": {\">=\": [{\"var\": \"survey.updated_at\"}, {\"var\": \"survey.created_at\"}]}}, {\"id\": \"CDC-DQ2-CEL-CAPACITY\", \"type\": \"custom\", \"engine\": \"cel\", \"description\": \"School capacity when present must be positive.\", \"severity\": \"ERROR\", \"path\": \"school\", \"message\": \"School capacity must be greater than zero.\", \"implementation\": \"school.capacity > 0\"}]",
  "sampleValidFixtures": [
    "{\"survey\": {\"id\": \"SURV-001\", \"created_at\": \"2026-10-15T10:00:00Z\", \"updated_at\": \"2026-10-15T14:30:00Z\"}, \"school\": {\"urn\": \"123456\", \"capacity\": 450}}"
  ],
  "sampleInvalidFixtures": [
    "{\"survey\": {\"id\": \"SURV-001\", \"created_at\": \"2026-10-15T16:00:00Z\", \"updated_at\": \"2026-10-15T10:00:00Z\"}, \"school\": {\"urn\": \"123456\", \"capacity\": 450}}",
    "{\"survey\": {\"id\": \"SURV-001\", \"created_at\": \"2026-10-15T10:00:00Z\", \"updated_at\": \"2026-10-15T14:30:00Z\"}, \"school\": {\"urn\": \"123456\", \"capacity\": 0}}"
  ]
}


### 1.4 Verify Route A: Paired Draft-07 JSON Schema + Companion Rules (edc-school-site)
# Route: POST /schemas/verify with schemaJson + rulesJson + fixtures
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"properties\": {\"survey\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^SURV-[A-Za-z0-9-]+$\"}, \"survey_name\": {\"type\": \"string\"}, \"participant_id\": {\"type\": \"string\"}, \"surveyor_email\": {\"type\": [\"string\", \"null\"], \"format\": \"email\"}, \"is_complete\": {\"type\": \"boolean\"}, \"created_at\": {\"type\": \"string\", \"format\": \"date-time\"}, \"updated_at\": {\"type\": \"string\", \"format\": \"date-time\"}}, \"required\": [\"id\", \"survey_name\", \"participant_id\", \"is_complete\", \"created_at\", \"updated_at\"]}, \"school\": {\"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"string\", \"pattern\": \"^[0-9]{6}$\"}, \"name\": {\"type\": \"string\"}, \"local_authority\": {\"type\": [\"string\", \"null\"]}}, \"required\": [\"urn\", \"name\"]}, \"sites\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"blocks\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\"}, \"floors\": {\"type\": [\"array\", \"null\"], \"items\": {\"type\": [\"object\", \"null\"], \"properties\": {\"name\": {\"type\": \"string\"}}, \"required\": [\"name\"]}}}, \"required\": [\"name\", \"type\"]}}}, \"required\": [\"name\", \"blocks\"]}}}, \"required\": [\"survey\", \"school\", \"sites\"]}",
  "rulesJson": "[{\"id\": \"CDC-DQ1-JSONLogic\", \"type\": \"custom\", \"engine\": \"jsonlogic\", \"description\": \"Survey updated timestamp must be greater than or equal to survey creation timestamp.\", \"severity\": \"ERROR\", \"path\": \"survey\", \"message\": \"Survey updated timestamp must be greater than or equal to survey creation timestamp.\", \"implementation\": {\">=\": [{\"var\": \"survey.updated_at\"}, {\"var\": \"survey.created_at\"}]}}]",
  "sampleValidFixtures": [
    "{\"survey\": {\"id\": \"SURV-1234-5678\", \"survey_name\": \"CCD\", \"participant_id\": \"abc-def-ghi\", \"surveyor_email\": \"surveyor@supplier.com\", \"is_complete\": true, \"created_at\": \"2026-10-15T10:00:00Z\", \"updated_at\": \"2026-10-15T14:30:00Z\"}, \"school\": {\"urn\": \"123456\", \"name\": \"Example School\"}, \"sites\": [{\"name\": \"EFA1\", \"blocks\": [{\"name\": \"EFAA\", \"type\": \"block\", \"floors\": [{\"name\": \"EFAA-GF\"}]}]}]}"
  ],
  "sampleInvalidFixtures": [
    "{\"survey\": {\"id\": \"SURV-1234-5678\", \"survey_name\": \"CCD\", \"participant_id\": \"abc-def-ghi\", \"surveyor_email\": \"surveyor@supplier.com\", \"is_complete\": true, \"created_at\": \"2026-10-15T16:00:00Z\", \"updated_at\": \"2026-10-15T10:00:00Z\"}, \"school\": {\"urn\": \"123456\", \"name\": \"Example School\"}, \"sites\": [{\"name\": \"EFA1\", \"blocks\": [{\"name\": \"EFAA\", \"type\": \"block\", \"floors\": [{\"name\": \"EFAA-GF\"}]}]}]}"
  ]
}


### 1.5 Verify Route B (Raw YAML): Direct ODCS v3.2.0 Data Contract Verification
# Route: POST /schemas/verify with Content-Type: application/yaml
# Automatically parses ODCS v3.2.0 YAML into Draft-07 JSON Schema and extracts embedded quality rules.
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/yaml
X-File-Name: edc-school-site-jsonlogic.odcs.yaml
x-functions-key: {{adminFunctionKey}}

version: "1.0.0"
kind: DataContract
apiVersion: v3.2.0
id: edc-survey-sites
name: CCDSurveySubmission-Sites
status: draft
schema:
  - name: submission
    logicalType: object
    description: Top-level CCDSurveySubmission-Sites payload container
    properties:
      - name: survey
        logicalType: object
        required: true
        quality:
          - id: CDC-DQ1-JSONLogic
            type: custom
            engine: jsonlogic
            description: Survey updated timestamp must be greater than or equal to survey creation timestamp.
            implementation:
              ">=":
                - var: survey.updated_at
                - var: survey.created_at
        properties:
          - name: id
            logicalType: string
            required: true
            logicalTypeOptions:
              pattern: "^SURV-[A-Za-z0-9-]+$"
          - name: survey_name
            logicalType: string
            required: true
          - name: participant_id
            logicalType: string
            required: true
          - name: surveyor_email
            logicalType: string
            required: false
            logicalTypeOptions:
              format: email
          - name: is_complete
            logicalType: boolean
            required: true
          - name: created_at
            logicalType: timestamp
            required: true
          - name: updated_at
            logicalType: timestamp
            required: true
      - name: school
        logicalType: object
        required: true
        properties:
          - name: urn
            logicalType: string
            required: true
            logicalTypeOptions:
              pattern: "^[0-9]{6}$"
          - name: name
            logicalType: string
            required: true
      - name: sites
        logicalType: array
        required: true
        items:
          logicalType: object
          required: true
          properties:
            - name: name
              logicalType: string
              required: true
            - name: blocks
              logicalType: array
              required: true
              items:
                logicalType: object
                required: true
                properties:
                  - name: name
                    logicalType: string
                    required: true
                  - name: type
                    logicalType: string
                    required: true


### 1.6 Verify Route B (JSON Envelope): ODCS v3.2.0 YAML + Fixture Dry-Runs
# Route: POST /schemas/verify with odcsYaml + sampleValidFixtures + sampleInvalidFixtures
POST {{adminBaseUrl}}/schemas/verify
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "fileName": "edc-school-site-jsonlogic.odcs.yaml",
  "odcsYaml": "version: \"1.0.0\"\nkind: DataContract\napiVersion: v3.2.0\nid: edc-survey-sites\nname: CCDSurveySubmission-Sites\nschema:\n  - name: submission\n    logicalType: object\n    properties:\n      - name: survey\n        logicalType: object\n        required: true\n        quality:\n          - id: CDC-DQ1-JSONLogic\n            type: custom\n            engine: jsonlogic\n            description: Survey updated timestamp must be greater than or equal to survey creation timestamp.\n            implementation:\n              \">=\":\n                - var: survey.updated_at\n                - var: survey.created_at\n        properties:\n          - name: id\n            logicalType: string\n            required: true\n          - name: created_at\n            logicalType: timestamp\n            required: true\n          - name: updated_at\n            logicalType: timestamp\n            required: true\n      - name: school\n        logicalType: object\n        required: true\n        properties:\n          - name: urn\n            logicalType: string\n            required: true\n            logicalTypeOptions:\n              pattern: \"^[0-9]{6}$\"\n          - name: name\n            logicalType: string\n            required: true\n",
  "sampleValidFixtures": [
    "{\"survey\": {\"id\": \"SURV-100\", \"created_at\": \"2026-10-15T10:00:00Z\", \"updated_at\": \"2026-10-15T12:00:00Z\"}, \"school\": {\"urn\": \"123456\", \"name\": \"Example School\"}}"
  ],
  "sampleInvalidFixtures": [
    "{\"survey\": {\"id\": \"SURV-100\", \"created_at\": \"2026-10-15T15:00:00Z\", \"updated_at\": \"2026-10-15T12:00:00Z\"}, \"school\": {\"urn\": \"123456\", \"name\": \"Example School\"}}"
  ]
}


### =========================================================================
### 2. ADMIN SCHEMA INGESTION, SCHEDULING & CATALOGUE INSPECTION (Admin API)
###    Submitted schemas are stored as 'Validated' (unscheduled) until
###    scheduled via PATCH /schemas/{schemaName}/versions/{version}/schedule
### =========================================================================

### 2.1 Submit Schema v1 with Companion Quality Rules (edc_payload) — Stored Unscheduled ('Validated')
# Route: POST /schemas/{schemaName}/versions/{version:int}
POST {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"$id\": \"https://dfe_cde_edc_integtration/schemas/edc_payload.schema.json\", \"title\": \"edc_payload\", \"description\": \"JSON Schema for eed_catalogue_30_bronze.cde_edc_integration.edc_payload\", \"schemaVersion\": 1, \"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"integer\", \"minimum\": 100000, \"maximum\": 999999, \"description\": \"Unique Reference Number\"}, \"school_name\": {\"type\": \"string\", \"minLength\": 1}, \"school_address\": {\"type\": \"string\"}, \"local_authority\": {\"type\": [\"string\", \"null\"]}, \"telephone\": {\"type\": [\"string\", \"null\"]}, \"diocese\": {\"type\": [\"string\", \"null\"]}, \"school_capacity\": {\"type\": [\"integer\", \"null\"], \"minimum\": 0}}, \"required\": [\"urn\", \"school_name\", \"school_address\"], \"additionalProperties\": false}",
  "rulesJson": "[{\"id\": \"RULE-CAPACITY-POSITIVE\", \"type\": \"custom\", \"engine\": \"jsonlogic\", \"description\": \"School capacity must be positive when specified.\", \"severity\": \"ERROR\", \"path\": \"school_capacity\", \"message\": \"School capacity must be greater than zero when specified.\", \"implementation\": {\"or\": [{\"==\": [{\"var\": \"school_capacity\"}, null]}, {\">\": [{\"var\": \"school_capacity\"}, 0]}]}}]",
  "identifierConfig": {
    "type": "URN",
    "jsonPointer": "/urn",
    "required": true
  }
}


### 2.2 Submit Schema v2 (Evolution Example — school_capacity removed) — Stored Unscheduled ('Validated')
# Route: POST /schemas/{schemaName}/versions/{version:int}
POST {{adminBaseUrl}}/schemas/{{schemaName}}/versions/2
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "schemaJson": "{\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", \"$id\": \"https://dfe_cde_edc_integtration/schemas/edc_payload.schema.json\", \"title\": \"edc_payload\", \"description\": \"JSON Schema for eed_catalogue_30_bronze.cde_edc_integration.edc_payload v2\", \"schemaVersion\": 2, \"type\": \"object\", \"properties\": {\"urn\": {\"type\": \"integer\"}, \"school_name\": {\"type\": \"string\"}, \"school_address\": {\"type\": \"string\"}, \"local_authority\": {\"type\": [\"string\", \"null\"]}, \"telephone\": {\"type\": [\"string\", \"null\"]}, \"diocese\": {\"type\": [\"string\", \"null\"]}}, \"required\": [\"urn\", \"school_name\", \"school_address\"], \"additionalProperties\": false}"
}


### 2.3 Submit ODCS v3.2.0 Contract Directly via Raw YAML (edc-survey-sites v1)
# Route: POST /schemas/{schemaName}/versions/{version:int}
POST {{adminBaseUrl}}/schemas/{{odcsSiteSchemaName}}/versions/1
Content-Type: application/yaml
X-File-Name: edc-school-site-jsonlogic.odcs.yaml
x-functions-key: {{adminFunctionKey}}

version: "1.0.0"
kind: DataContract
apiVersion: v3.2.0
id: edc-survey-sites
name: CCDSurveySubmission-Sites
status: draft
schema:
  - name: submission
    logicalType: object
    description: Top-level CCDSurveySubmission-Sites payload container
    properties:
      - name: survey
        logicalType: object
        required: true
        quality:
          - id: CDC-DQ1-JSONLogic
            type: custom
            engine: jsonlogic
            description: Survey updated timestamp must be greater than or equal to survey creation timestamp.
            implementation:
              ">=":
                - var: survey.updated_at
                - var: survey.created_at
        properties:
          - name: id
            logicalType: string
            required: true
            logicalTypeOptions:
              pattern: "^SURV-[A-Za-z0-9-]+$"
          - name: survey_name
            logicalType: string
            required: true
          - name: participant_id
            logicalType: string
            required: true
          - name: surveyor_email
            logicalType: string
            required: false
            logicalTypeOptions:
              format: email
          - name: is_complete
            logicalType: boolean
            required: true
          - name: created_at
            logicalType: timestamp
            required: true
          - name: updated_at
            logicalType: timestamp
            required: true
      - name: school
        logicalType: object
        required: true
        properties:
          - name: urn
            logicalType: string
            required: true
            logicalTypeOptions:
              pattern: "^[0-9]{6}$"
          - name: name
            logicalType: string
            required: true
          - name: local_authority
            logicalType: string
            required: false
      - name: sites
        logicalType: array
        required: true
        items:
          logicalType: object
          required: true
          properties:
            - name: name
              logicalType: string
              required: true
            - name: blocks
              logicalType: array
              required: true
              items:
                logicalType: object
                required: true
                properties:
                  - name: name
                    logicalType: string
                    required: true
                  - name: type
                    logicalType: string
                    required: true
                  - name: floors
                    logicalType: array
                    required: false
                    items:
                      logicalType: object
                      properties:
                        - name: name
                          logicalType: string
                          required: true


### 2.4 Admin List All Schemas (Includes Unscheduled 'Validated' & 'Retired' Versions)
# Route: GET /schemas (Admin App defaults: includeUnscheduled=true, includeFields=true)
GET {{adminBaseUrl}}/schemas?includeUnscheduled=true&includeFields=true
Accept: application/json
x-functions-key: {{adminFunctionKey}}


### 2.5 Admin Filter Schemas by Name
# Route: GET /schemas?schemaName={schemaName}
GET {{adminBaseUrl}}/schemas?schemaName={{schemaName}}&includeUnscheduled=true&includeFields=true
Accept: application/json
x-functions-key: {{adminFunctionKey}}


### 2.6 Admin Get Schema Version Full Detail (Includes Unscheduled & Raw JSON Schema)
# Route: GET /schemas/{schemaName}/versions/{version:int}
# Admin App defaults: includeUnscheduled=true, includeRawJsonSchema=true
GET {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1?includeUnscheduled=true&includeRawJsonSchema=true
Accept: application/json
x-functions-key: {{adminFunctionKey}}


### 2.7 Schedule / Activate Schema v1 (edc_payload)
# Route: PATCH /schemas/{schemaName}/versions/{version:int}/schedule
# Assigns effective dates so Schema v1 transitions from 'Validated' to 'Active' and becomes publicly discoverable.
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "effectiveFromUtc": "2026-01-01T00:00:00Z",
  "effectiveToUtc": "2027-12-31T23:59:59Z",
  "lifecycleAction": "Schedule"
}


### 2.8 Schedule / Activate ODCS Schema v1 (edc-survey-sites) & Set URN Pointer (/school/urn)
# Route: PATCH /schemas/{schemaName}/versions/{version:int}/schedule
PATCH {{adminBaseUrl}}/schemas/{{odcsSiteSchemaName}}/versions/1/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "effectiveFromUtc": "2026-01-01T00:00:00Z",
  "effectiveToUtc": "2027-12-31T23:59:59Z",
  "lifecycleAction": "Schedule",
  "identifierConfig": {
    "type": "URN",
    "jsonPointer": "/school/urn",
    "required": true
  }
}


### 2.9 Schedule Schema v2 for Future Activation Window
# Route: PATCH /schemas/{schemaName}/versions/{version:int}/schedule
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/2/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "effectiveFromUtc": "2027-01-01T00:00:00Z",
  "effectiveToUtc": "2028-12-31T23:59:59Z",
  "lifecycleAction": "Schedule"
}


### 2.10 Deprecate a Schema Version (Lifecycle Transition)
# Route: PATCH /schemas/{schemaName}/versions/{version:int}/schedule
# Allowed lifecycleAction values: "Schedule", "Activate", "Deprecate", "Retire"
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/2/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "lifecycleAction": "Deprecate"
}


### 2.11 Retire a Schema Version (Lifecycle Transition — Blocks Traffic)
# Route: PATCH /schemas/{schemaName}/versions/{version:int}/schedule
PATCH {{adminBaseUrl}}/schemas/{{schemaName}}/versions/2/schedule
Content-Type: application/json
x-functions-key: {{adminFunctionKey}}

{
  "lifecycleAction": "Retire"
}


### =========================================================================
### 3. PUBLIC SCHEMA DISCOVERY & CATALOGUE (Public API)
###    Exposes only scheduled/active schemas unless includeUnscheduled=true
### =========================================================================

### 3.1 List All Publicly Visible Schemas
# Route: GET /schemas
# Returns all scheduled/active schemas with their activeVersion, version summaries, and extracted activeVersionFields.
GET {{baseUrl}}/schemas?includeFields=true
Accept: application/json
x-functions-key: {{functionKey}}


### 3.2 Get Specific Schema Catalogue Entry by Name (edc_payload)
# Route: GET /schemas/{schemaName}
GET {{baseUrl}}/schemas/{{schemaName}}?includeFields=true
Accept: application/json
x-functions-key: {{functionKey}}


### 3.3 Get Public Schema Version Detail (Extracted Fields, Constraints & Quality Rules)
# Route: GET /schemas/{schemaName}/versions/{version:int}
# Set includeRawJsonSchema=true to also include the raw JSON Schema string in the response.
GET {{baseUrl}}/schemas/{{schemaName}}/versions/1?includeRawJsonSchema=true
Accept: application/json
x-functions-key: {{functionKey}}


### 3.4 Get Public ODCS Schema Version Detail (edc-survey-sites v1)
# Route: GET /schemas/{schemaName}/versions/{version:int}
GET {{baseUrl}}/schemas/{{odcsSiteSchemaName}}/versions/1?includeRawJsonSchema=true
Accept: application/json
x-functions-key: {{functionKey}}


### =========================================================================
### 4. SURVEY INGESTION WORKFLOW — GENERIC EDC SCHEMA (Public API)
### =========================================================================

### 4.1 Create Submission Session (Auto-resolves current active schema schedule)
# @name createSessionAuto
POST {{baseUrl}}/submissions/{{schemaName}}
x-functions-key: {{functionKey}}

> {%
  if (response.body && response.body.data && response.body.data.submissionId) {
    client.global.set("submissionId", response.body.data.submissionId);
  }
%}


### 4.2 Create Submission Session (Explicitly pinning Version 1)
# @name createSessionExplicit
POST {{baseUrl}}/submissions/{{schemaName}}?version=1
x-functions-key: {{functionKey}}

> {%
  if (response.body && response.body.data && response.body.data.submissionId) {
    client.global.set("submissionId", response.body.data.submissionId);
  }
%}


### 4.3 Upload Partial Draft 1 (Incomplete: Missing required 'school_address')
# Persists to 'payloads' landing container and returns pending validation issues with 200 OK
PUT {{baseUrl}}/submissions/{{submissionId}}
Content-Type: application/json
x-functions-key: {{functionKey}}

{
  "urn": 104521,
  "school_name": "St Mary's High School"
}


### 4.4 Upload Partial Draft 2 (Incomplete: Wrong data type on 'urn')
PUT {{baseUrl}}/submissions/{{submissionId}}
Content-Type: application/json
x-functions-key: {{functionKey}}

{
  "urn": "NOT_A_VALID_NUMBER",
  "school_name": "St Mary's High School",
  "school_address": "High Street, Leeds"
}


### 4.5 Upload Complete & Valid Draft
# All required fields present and conforms to pinned Schema v1 and JsonLogic rules
PUT {{baseUrl}}/submissions/{{submissionId}}
Content-Type: application/json
x-functions-key: {{functionKey}}

{
  "urn": 104521,
  "school_name": "St Mary's High School",
  "school_address": "High Street, Leeds",
  "local_authority": "Leeds",
  "telephone": "0113 123 4567",
  "diocese": "Diocese of Leeds",
  "school_capacity": 450
}


### 4.6 Attempt to Finalise when Invalid (Demonstrating 422 Rejection)
# If called while draft is in state 4.3 or 4.4, this returns 422 Unprocessable Entity
# and payload remains safely in 'payloads' container.
POST {{baseUrl}}/submissions/{{submissionId}}/finalise
x-functions-key: {{functionKey}}


### 4.7 Finalise Submission (Success: Promotes from 'payloads' to 'processed' data lake storage)
# Validates complete payload, extracts URN, tags with SHA-256 integrity hash, moves to 'processed' container,
# and flags status as ReadyForCde.
POST {{baseUrl}}/submissions/{{submissionId}}/finalise
x-functions-key: {{functionKey}}


